[TEMPLATE]
# Copy to .env and fill in what you need. Never commit .env.
LLM_BACKEND=agent_queue
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=
LLM_MODEL=freebuff-desktop-agent
LLM_RPM=20
OLLAMA_HOST=http://localhost:11434
KAGGLE_USERNAME=
KAGGLE_KEY=
# Optional: where the Laya cross-check caches its checkpoints (default ~/.cache/huggingface/hub).
# Only relevant if you installed the optional extra with `make setup-laya`.
# HF_HUB_CACHE=/tmp/hf_laya
